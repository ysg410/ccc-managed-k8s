# Privateer config for the CCC.K8S behavioural tests against the workshop AKS
# cluster. Derived from upstream common-cloud-controls
# cfi-testing/privateer-config/avm/azure-avm-kubernetes.yml (branch
# managed-k8s-behavioural), customised for this environment.
#
# 50-run-ccc-tests.sh renders it with envsubst, filling only the cluster
# coordinates (${CLUSTER_NAME}, ${LOCATION}, ...). ${AZURE_TEST_USER_*} and
# ${REACHABILITY_PROBE_SHARED_SECRET} stay in the rendered file and are expanded
# by the plugin at runtime, so no secret is written to disk by the render.
#
# Differences from the upstream AVM config:
#   - azure-aks-kube-transport: direct. The example disables AKS Run Command,
#     so command-invoke cannot work; direct needs the private API, so the run
#     happens on the jumpbox after 20-verify-cluster.sh linked the DNS zone.
#   - Every image in the manifests below is digest-pinned and the "compliant"
#     Pods satisfy Pod Security "restricted", because the ccc-test namespace
#     enforces both (k8s-fixtures.yaml). Each negative manifest violates only
#     the rule its scenario is about.
#   - Workload identity probe, storage classes, webhook probe and reachability
#     observer point at fixtures created by 40-setup-ccc-tests.sh and
#     55-run-ccc-tests-from-laptop.sh.
#   - Only test-user-no-access is configured: it is the only identity the
#     kubernetes scenarios use.
loglevel: info
write-directory: evaluation_results
write: true
output: yaml

services:
  azureKubernetes:
    plugin: ccc-behavioural-plugin
    policy:
      catalogs:
        - CCC.K8S
      applicability:
        - tlp-amber
        - tlp-clear
        - tlp-green
        - tlp-red
    vars:
      service: kubernetes
      service-type: kubernetes
      tags: "@Behavioural @kubernetes"
      provider: azure
      timeout: 60m
      catalog-versions:
        CCC.Core: v2025.10
        CCC.K8S: DEV

      # Cluster under test (from the example's Terraform outputs on the jumpbox)
      region: "${LOCATION}"
      resource: "${CLUSTER_NAME}"
      kubernetes-cluster-name: "${CLUSTER_NAME}"
      azure-aks-name: "${CLUSTER_NAME}"
      azure-subscription-id: "${SUBSCRIPTION_ID}"
      azure-tenant-id: "${TENANT_ID}"
      azure-resource-group: "${RESOURCE_GROUP}"
      private-fqdn: "${PRIVATE_FQDN}"
      oidc-issuer-url: "${OIDC_ISSUER_URL}"
      azure-aks-kube-transport: direct
      permitted-regions:
        - "${LOCATION}"
      # Log Analytics workspace customer ID (GUID), not the ARM ID. Audit logs
      # only arrive when aks_monitoring_enabled = true.
      azure-log-analytics-workspace-id: "${LOG_ANALYTICS_WORKSPACE_GUID}"

      # CN15: the example's required tags (variables.tf validation).
      required-metadata-keys:
        - environment
        - owner
        - data-classification
      governance-metadata-target: cluster
      governance-metadata-patch:
        owner: ccc-unauthorized-change

      # CN09 / CN12 / CN13
      min-supported-version: "1.31"
      approved-autoscaler-max: 10
      approved-hpa-max-replicas: 10
      kubelet-ports: "10250,10255"
      node-mgmt-ports: "22,3389"
      node-probe-timeout-ms: 5000

      # CN01: "untrusted" API reachability. remote = the observer on your
      # laptop through the SSH tunnel (55-run-ccc-tests-from-laptop.sh);
      # local = probed from the jumpbox, which is inside the approved network.
      reachability-probe-mode: "${REACHABILITY_PROBE_MODE}"
      reachability-probe-url: "${REACHABILITY_PROBE_URL}"
      reachability-probe-observer: "${REACHABILITY_PROBE_OBSERVER}"
      reachability-probe-shared-secret: "${REACHABILITY_PROBE_SHARED_SECRET}"
      reachability-probe-timeout-ms: 5000

      # In-cluster fixtures (k8s-fixtures.yaml)
      test-workload-namespace: ccc-test
      test-workload-service-account: ccc-wi-sa
      test-workload-service-account-unbound: ccc-wi-sa-unbound
      protected-secret-name: ccc-protected-secret
      unrelated-secret-name: ccc-unrelated-secret
      secret-watch-timeout-ms: 3000

      # CN03.AR01: storage account + blob read by the ccc-wi-sa workload identity
      wi-probe-action: probe-read
      wi-probe-resource: "${WI_STORAGE_ACCOUNT}"
      wi-probe-container: probe
      wi-probe-object: probe.txt
      wi-probe-expected: ccc-wi-probe-ok

      # CN06
      network-probe-selector: "role=network-probe"
      isolated-probe-selector: "role=isolated-probe"
      security-probe-selector: "role=security-probe"
      network-probe-image: "busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
      pvc-consumer-image: "busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
      network-probe-port: 8080
      network-probe-protocol: tcp
      network-allowlist-host: "ccc-allowed.ccc-network-control.svc"
      network-denylist-host: "ccc-denied.ccc-network-control.svc"
      network-control-host: "ccc-control.ccc-network-control.svc"
      network-control-namespace: ccc-network-control

      # CN11.AR03 (webhook-probe.yaml)
      webhook-probe-namespace: ccc-admission-webhook-probe
      webhook-probe-test-namespace: ccc-admission-webhook-test
      webhook-probe-deployment: ccc-admission-webhook-probe
      webhook-probe-service: ccc-admission-webhook-probe
      webhook-probe-configuration: ccc-admission-webhook-probe

      # Admission manifests (server-side dry run only)
      unapproved-tag-image-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-unapproved-image
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:latest
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      privileged-workload-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-privileged
          namespace: ccc-test
        spec:
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              securityContext:
                privileged: true
      privileged-controller-update-manifest: |
        apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: ccc-privileged-deploy
          namespace: ccc-test
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: ccc-privileged-deploy
          template:
            metadata:
              labels:
                app: ccc-privileged-deploy
            spec:
              containers:
                - name: pause
                  image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
                  securityContext:
                    privileged: true
      insecure-security-context-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-insecure-context
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              securityContext:
                allowPrivilegeEscalation: true
                capabilities: { drop: ["ALL"] }
      static-credential-workload-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-static-creds
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              env:
                - name: AZURE_CLIENT_SECRET
                  value: "not-a-real-secret"
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      compliant-no-static-cred-workload-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-no-static-creds
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      missing-resource-bounds-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-missing-bounds
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      compliant-resource-bounds-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-compliant-bounds
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              resources:
                requests: { cpu: 50m, memory: 64Mi }
                limits: { cpu: 100m, memory: 128Mi }
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      quota-exceed-workload-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-quota-exceed
          namespace: ccc-test
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              resources:
                requests: { cpu: "32", memory: 64Gi }
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }
      disallowed-pvc-manifest: |
        apiVersion: v1
        kind: PersistentVolumeClaim
        metadata:
          name: ccc-disallowed-pvc
          namespace: ccc-test
        spec:
          accessModes: ["ReadWriteMany"]
          resources:
            requests: { storage: 1Gi }
          storageClassName: ccc-blocked-sc
      compliant-pvc-manifest: |
        apiVersion: v1
        kind: PersistentVolumeClaim
        metadata:
          name: ccc-compliant-pvc
          namespace: ccc-test
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests: { storage: 1Gi }
          storageClassName: ccc-approved-sc
      webhook-compliant-probe-manifest: |
        apiVersion: v1
        kind: Pod
        metadata:
          name: ccc-webhook-probe
          namespace: ccc-admission-webhook-test
          labels:
            ccc.finos.org/webhook-probe-object: "true"
        spec:
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: pause
              image: busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
              resources:
                requests: { cpu: 50m, memory: 64Mi }
                limits: { cpu: 100m, memory: 128Mi }
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: ["ALL"] }

      test-identities:
        test-user-no-access:
          user-name: "${AZURE_TEST_USER_NO_ACCESS_USER_NAME}"
          client_id: "${AZURE_TEST_USER_NO_ACCESS_CLIENT_ID}"
          client_secret: "${AZURE_TEST_USER_NO_ACCESS_CLIENT_SECRET}"
          object_id: "${AZURE_TEST_USER_NO_ACCESS_OBJECT_ID}"
