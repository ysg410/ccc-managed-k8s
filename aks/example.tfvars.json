{
  "name": "example-aks",
  "location": "eastus2",
  "resource_group_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg",
  "kubernetes_version": "1.37",
  "sku_tier": "Standard",
  "support_plan": "KubernetesOfficial",
  "node_resource_group_name": "example-aks-nodes-rg",
  "private_dns_zone_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/dns-rg/providers/Microsoft.Network/privateDnsZones/privatelink.eastus2.azmk8s.io",
  "control_plane_identity_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/aks-control-plane",
  "kubelet_identity_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/aks-kubelet",
  "disk_encryption_set_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/diskEncryptionSets/aks-des",
  "key_vault_key_id": "https://example.vault.azure.net/keys/aks-kms/00000000000000000000000000000000",
  "key_vault_resource_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.KeyVault/vaults/example",
  "cluster_admin_group_object_ids": [
    "00000000-0000-0000-0000-000000000001"
  ],
  "subnet_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/network-rg/providers/Microsoft.Network/virtualNetworks/example-vnet/subnets/aks-nodes",
  "api_server_subnet_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/network-rg/providers/Microsoft.Network/virtualNetworks/example-vnet/subnets/aks-api-server",
  "dns_service_ip": "172.16.0.53",
  "service_cidr": "172.16.0.0/16",
  "acns_enabled": true,
  "secrets_store_csi_driver_enabled": true,
  "kaito_enabled": true,
  "node_os_upgrade_channel": "NodeImage",
  "maintenance_window_node_os": {
    "interval": 1,
    "day_of_week": "Wednesday",
    "start_time": "20:00",
    "duration": 8,
    "utc_offset": "-04:00"
  },
  "node_provisioning_mode": "Manual",
  "auto_scaler_profile": {
    "expander": "random",
    "scan_interval": "10s",
    "empty_bulk_delete_max": "20",
    "balance_similar_node_groups": "true",
    "max_graceful_termination_sec": "600",
    "max_node_provisioning_time": "20m",
    "max_unready_nodes": "4",
    "max_unready_percentage": "45",
    "scale_down_delay_after_add": "10m",
    "scale_down_unneeded": "10m",
    "scale_down_utilization_threshold": "0.5",
    "skip_nodes_with_local_storage": "false",
    "skip_nodes_with_system_pods": "true"
  },
  "node_pools": [
    {
      "name": "system",
      "vm_size": "Standard_D4s_v5",
      "max_pods_per_node": 30,
      "system_nodepool": true,
      "enable_auto_scaling": true,
      "min_count": 3,
      "max_count": 6,
      "max_surge": "33%",
      "os_disk_size_gb": 128,
      "os_disk_type": "Managed",
      "availability_zones": [
        "1",
        "2",
        "3"
      ],
      "sysctl_config": {
        "net_core_somaxconn": 32768,
        "net_ipv4_ip_local_port_range_min": 32768,
        "net_ipv4_ip_local_port_range_max": 60999,
        "net_ipv4_tcp_tw_reuse": true
      },
      "tags": {
        "pool": "system"
      }
    },
    {
      "name": "apps",
      "vm_size": "Standard_D8s_v5",
      "max_pods_per_node": 50,
      "enable_auto_scaling": true,
      "min_count": 2,
      "max_count": 10,
      "max_surge": "33%",
      "node_labels": {
        "workload": "applications"
      },
      "tags": {
        "pool": "applications"
      }
    },
    {
      "name": "spot",
      "vm_size": "Standard_D8s_v5",
      "node_count": 2,
      "max_pods_per_node": 50,
      "priority": "Spot",
      "eviction_policy": "Delete",
      "spot_max_price": -1,
      "tags": {
        "pool": "spot"
      }
    }
  ],
  "tags": {
    "environment": "test",
    "managed-by": "terraform"
  },
  "timeouts": {
    "create": "90m",
    "delete": "90m",
    "read": "10m",
    "update": "90m"
  }
}
